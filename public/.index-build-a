 if(typeof baseAdmin==='function')window.renderAdmin=async function(){await baseAdmin();const host=document.getElementById('admin');if(!host||host.querySelector('[data-cancellations-v418]'))return;let a=[];try{const x=await api('/api/admin/cancellations');if(x.r.ok)a=x.j.items||[]}catch(e){}const sec=document.createElement('div');sec.dataset.cancellationsV418='1';const open=a.filter(x=>['pending','in_review'].includes(x.status)).length;sec.innerHTML='<div class="sectionHead" style="margin-top:16px"><div><h2>طلبات الإلغاء والاسترداد</h2><p>الإلغاء منفصل عن النزاع، والاسترداد لا يُعتبر منفذًا قبل تأكيد حالة مزود الدفع.</p></div><span class="pill '+(open?'amber':'green')+'">'+open+' قيد المراجعة</span></div><div class="cancelAdminGrid">'+(a.map(x=>'<div class="cancelAdminCard"><div class="row space"><h3>'+esc(x.title||('طلب #'+x.order_id))+'</h3><span class="pill '+(['pending','in_review'].includes(x.status)?'amber':x.status==='approved'?'gray':'green')+'">'+cancelStatus(x.status)+'</span></div><p>العميل: '+esc(x.client_name)+' · المستقل: '+esc(x.freelancer_name)+'</p><p>الطالب: '+esc(x.requested_by_name)+' · '+esc(x.reason)+'</p><p>'+refundStatus(x.refund_status||'not_needed')+'</p>'+(x.refund_status==='manual_required'?'<div class="refundWarn">لا تسجل «تم الاسترداد» إلا بعد تنفيذ العملية فعليًا لدى مزود الدفع.</div>':'')+(['pending','in_review'].includes(x.status)?'<button class="btn soft" style="margin-top:8px" onclick="adminCancellationModal('+x.id+',\''+x.status+'\',\''+(x.payment_status||'')+'\')">معالجة</button>':x.status==='approved'&&x.refund_status==='manual_required'?'<button class="btn primary" style="margin-top:8px" onclick="markCancellationRefunded('+x.id+')">تم الاسترداد فعليًا</button>':'')+'</div>').join('')||'<div class="card empty">لا توجد طلبات إلغاء.</div>')+'</div>';host.appendChild(sec)};
 window.adminCancellationModal=function(id,status,payment){openModal('<div class="modalHead"><h2>معالجة طلب الإلغاء</h2><button class="x" onclick="closeModal()">×</button></div><div class="field"><label>ملاحظة الإدارة</label><textarea id="cancelAdminNote" placeholder="سبب القرار أو تعليمات للطرفين"></textarea></div>'+(payment==='paid'?'<div class="refundWarn">الطلب مدفوع. في الدفع التجريبي يتم تحديث الاسترداد تلقائيًا؛ في مزود الدفع الحقيقي سيبقى «يلزم استرداد» حتى تنفذه وتؤكده.</div>':'')+'<div class="actions">'+(status==='pending'?'<button class="btn soft" onclick="adminCancellationAction('+id+',\'in_review\')">قيد المراجعة</button>':'')+'<button class="btn danger" onclick="adminCancellationAction('+id+',\'approved\')">اعتماد الإلغاء</button><button class="btn green" onclick="adminCancellationAction('+id+',\'rejected\')">رفض الإلغاء</button></div>')};
 window.adminCancellationAction=async function(id,status){const note=document.getElementById('cancelAdminNote').value;const {r,j}=await api('/api/admin/cancellations/'+id,{method:'PATCH',body:JSON.stringify({status,admin_note:note})});if(!r.ok)return toast(j?.error==='cancellation_finalized'?'تم إغلاق الطلب مسبقًا':'تعذر تحديث طلب الإلغاء');closeModal();toast(status==='approved'?(j?.refund_action_required?'تم الإلغاء — باقي تنفيذ الاسترداد لدى مزود الدفع':'تم اعتماد الإلغاء'):(status==='rejected'?'تم رفض طلب الإلغاء':'تم تحويله للمراجعة'));renderAdmin()};
 window.markCancellationRefunded=async function(id){if(!confirm('تأكد أن الاسترداد تم فعليًا لدى مزود الدفع قبل تسجيله هنا.'))return;const {r,j}=await api('/api/admin/cancellations/'+id,{method:'PATCH',body:JSON.stringify({refund_status:'refunded',admin_note:'تم تأكيد الاسترداد بعد المعالجة لدى مزود الدفع'})});if(!r.ok)return toast('تعذر تحديث الاسترداد');toast('تم تسجيل الاسترداد');renderAdmin()};
})();
