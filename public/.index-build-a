<script>
(function(){
 const safeHttps=u=>{try{const x=new URL(String(u||'').trim());return x.protocol==='https:'?x.href:''}catch(e){return''}};
 const fileNameFromUrl=u=>{try{const x=new URL(u),n=decodeURIComponent(x.pathname.split('/').filter(Boolean).pop()||'ملف');return n.slice(0,90)||'ملف'}catch(e){return'ملف'}};
 const parseAttachments=txt=>String(txt||'').split(/\n+/).map(x=>x.trim()).filter(Boolean).slice(0,5).map(line=>{let name='',url=line;if(line.includes('|')){const p=line.split('|');name=p.shift().trim();url=p.join('|').trim()}url=safeHttps(url);if(!url)return null;return{name:name||fileNameFromUrl(url),url,mime_type:'application/octet-stream',size_bytes:0}}).filter(Boolean);
 const fmtBytes=n=>{n=Number(n||0);if(!n)return'';if(n<1024)return n+' B';if(n<1048576)return(n/1024).toFixed(1)+' KB';return(n/1048576).toFixed(1)+' MB'};
 let storageCfg=null;
 const fileAccept='.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.webp,.zip,.mp4,.mov,.mp3,.wav,.m4a';
 async function getStorageConfig(){if(storageCfg)return storageCfg;try{const x=await api('/api/v1/storage/config');storageCfg=x.r.ok?x.j:{mode:'external_links_beta',direct_uploads:false,max_upload_bytes:0}}catch(e){storageCfg={mode:'external_links_beta',direct_uploads:false,max_upload_bytes:0}}return storageCfg}
 function uploadMsg(id,msg,err=false){const el=$(id);if(el){el.textContent=msg||'';el.classList.toggle('err',!!err)}}
 async function uploadFiles(inputId,stateId){const input=$(inputId),files=[...(input?.files||[])].slice(0,5);if(!files.length)return[];const cfg=await getStorageConfig();if(!cfg.direct_uploads){uploadMsg(stateId,'رفع الملفات المباشر يحتاج Railway Bucket. استخدم رابط HTTPS مؤقتًا.',true);throw new Error('storage_not_configured')}const out=[];for(let i=0;i<files.length;i++){const f=files[i];uploadMsg(stateId,'جاري رفع '+(i+1)+'/'+files.length+' — '+f.name);const pre=await api('/api/v1/uploads/presign',{method:'POST',body:JSON.stringify({file_name:f.name,mime_type:f.type||'application/octet-stream',size_bytes:f.size})});if(!pre.r.ok){uploadMsg(stateId,'تعذر تجهيز رفع '+f.name,true);throw new Error(pre.j?.error||'presign_failed')}const up=await fetch(pre.j.upload_url,{method:'PUT',headers:pre.j.headers||{},body:f});if(!up.ok){uploadMsg(stateId,'فشل رفع '+f.name,true);throw new Error('bucket_upload_failed')}const done=await api('/api/v1/uploads/complete',{method:'POST',body:JSON.stringify({key:pre.j.key})});if(!done.r.ok){uploadMsg(stateId,'تعذر التحقق من '+f.name,true);throw new Error(done.j?.error||'upload_verify_failed')}out.push(done.j.attachment)}uploadMsg(stateId,'تم رفع '+out.length+' ملف بنجاح');return out}
