const DEMO_MODE=new URLSearchParams(location.search).get('demo')==='1'||location.hostname.includes('demo-live');
let connectionWarned=false;
async function api(path,opt={}){
  if(DEMO_MODE)return demoApi(path,opt);
  try{
    const netOpt={...opt,headers:{...(opt.headers||{}),...(token?{authorization:'Bearer '+token}:{})}};
    if(netOpt.body&&!netOpt.headers['content-type'])netOpt.headers['content-type']='application/json';
    const ctl=new AbortController(),timer=setTimeout(()=>ctl.abort(),5000);netOpt.signal=ctl.signal;
    const r=await fetch(path,netOpt);clearTimeout(timer);
    const ct=r.headers.get('content-type')||'';
    if(!ct.includes('application/json')||r.status>=500)throw new Error('backend_unavailable');
    let j=null;try{j=await r.json()}catch{throw new Error('invalid_json')}
    if(r.status===401&&token){localStorage.removeItem('minjaz_token');token='';showAuth()}
    connectionWarned=false;
    return {r,j};
  }catch(e){
    console.error('MINJAZ backend unavailable',e);
    if(!connectionWarned){connectionWarned=true;toast('تعذر الاتصال بخدمة مِنجاز. جرّب مرة ثانية بعد قليل')}
    return {r:{ok:false,status:0},j:{error:'backend_unavailable'}};
  }
}
