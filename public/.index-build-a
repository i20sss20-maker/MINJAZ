 const payoutStatus=s=>({pending:'قيد المراجعة',processing:'قيد التحويل',paid:'تم التحويل',rejected:'مرفوض',cancelled:'ملغي'}[s]||s);
 const payoutClass=s=>s==='paid'?'green':s==='rejected'||s==='cancelled'?'red':s==='processing'?'blue':'amber';

 const baseAccount=window.renderAccount;
 if(typeof baseAccount==='function')window.renderAccount=async function(){
   await baseAccount();
   if(me?.user?.role!=='freelancer')return;
   const host=document.getElementById('account');if(!host||host.querySelector('[data-earnings]'))return;
   let e=null;try{const x=await api('/api/v1/freelancer/earnings');if(x.r.ok)e=x.j}catch(err){}
   if(!e)return;
   const kyc=me?.freelancer_profile?.kyc_status||'pending';
   const sec=document.createElement('div');sec.dataset.earnings='1';
   sec.innerHTML='<div class="sectionHead"><div><h2>الأرباح والسحب</h2><p>الرصيد محسوب من الطلبات المكتملة بعد عمولة المنصة والطلبات المعلقة.</p></div><button class="btn primary" '+((Number(e.available_balance||0)<=0||kyc!=='approved')?'disabled':'')+' onclick="payoutModal('+Number(e.available_balance||0)+')">طلب سحب</button></div>'+
   '<div class="earningsGrid">'+
   '<div class="earnCard"><small>صافي الأرباح</small><b>'+money(e.net_earned||0)+'</b></div>'+
   '<div class="earnCard"><small>المتاح للسحب</small><b>'+money(e.available_balance||0)+'</b></div>'+
   '<div class="earnCard"><small>قيد المعالجة</small><b>'+money(e.pending_payouts||0)+'</b></div>'+
   '<div class="earnCard"><small>تم سحبه</small><b>'+money(e.paid_out||0)+'</b></div></div>'+
   (kyc!=='approved'?'<div class="disputeBanner"><b>يلزم اعتماد التوثيق قبل السحب</b><p>تقدر تشوف أرباحك الآن، لكن إرسال طلب سحب يتفعل بعد اعتماد KYC من الإدارة.</p></div>':'')+
   '<div class="payoutList">'+((e.payout_requests||[]).slice(0,8).map(x=>'<div class="payoutRow"><div><b>'+money(x.amount)+'</b><p>'+new Date(x.created_at).toLocaleString('ar-SA')+(x.admin_note?' · '+esc(x.admin_note):'')+'</p></div><span class="pill '+payoutClass(x.status)+'">'+payoutStatus(x.status)+'</span></div>').join('')||'<div class="card empty">ما عندك طلبات سحب حتى الآن.</div>')+'</div>';
   host.appendChild(sec);
 };

 window.payoutModal=function(max){
   openModal('<div class="modalHead"><div><h2>طلب سحب أرباح</h2><div style="font-size:9px;color:#64748b">المتاح: '+money(max)+'</div></div><button class="x" onclick="closeModal()">×</button></div><div class="field"><label>المبلغ</label><input id="payoutAmount" inputmode="decimal" value="'+Number(max).toFixed(2)+'"></div><div class="field"><label>ملاحظة — اختياري</label><textarea id="payoutNote" placeholder="أي ملاحظة للإدارة"></textarea></div><div class="actions"><button class="btn ghost" onclick="closeModal()">إلغاء</button><button class="btn primary" onclick="submitPayout()">إرسال طلب السحب</button></div>');
 };
 window.submitPayout=async function(){
   const amount=Number(document.getElementById('payoutAmount').value),note=document.getElementById('payoutNote').value;
   const {r,j}=await api('/api/v1/freelancer/payouts',{method:'POST',body:JSON.stringify({amount,note})});
   if(!r.ok){
     if(j?.error==='kyc_required')return toast('يلزم اعتماد التوثيق قبل السحب');
     if(j?.error==='insufficient_balance')return toast('المبلغ أكبر من الرصيد المتاح');
     return toast('راجع مبلغ السحب');
   }
   closeModal();toast('تم إرسال طلب السحب');renderAccount();if(window.refreshNotifBadge)refreshNotifBadge();
 };

 const baseAdmin=window.renderAdmin;
 if(typeof baseAdmin==='function')window.renderAdmin=async function(){
   await baseAdmin();
   const host=document.getElementById('admin');if(!host||host.querySelector('[data-payout-admin]'))return;
   let a=[];try{const x=await api('/api/admin/payouts');if(x.r.ok)a=x.j.items||[]}catch(e){}
   const sec=document.createElement('div');sec.dataset.payoutAdmin='1';
   const open=a.filter(x=>['pending','processing'].includes(x.status)).length;
   sec.innerHTML='<div class="sectionHead" style="margin-top:16px"><div><h2>طلبات السحب</h2><p>الرصيد المتاح محسوب من الطلبات المكتملة بعد العمولة والسحوبات السابقة.</p></div><span class="pill '+(open?'amber':'green')+'">'+open+' مفتوح</span></div><div class="list">'+(a.slice(0,30).map(x=>'<div class="rowCard"><div><h3>'+esc(x.freelancer_name)+' · '+money(x.amount)+'</h3><p>'+esc(x.phone)+' · KYC: '+esc(x.kyc_status||'pending')+' · المتاح الآن '+money(x.balance?.available_balance||0)+'</p>'+(x.admin_note?'<p>ملاحظة: '+esc(x.admin_note)+'</p>':'')+'</div><div><span class="pill '+payoutClass(x.status)+'">'+payoutStatus(x.status)+'</span>'+(['pending','processing'].includes(x.status)?'<button class="btn soft" style="display:block;margin-top:7px" onclick="adminPayoutModal('+x.id+','+JSON.stringify(x.status)+')">معالجة</button>':'')+'</div></div>').join('')||'<div class="card empty">لا توجد طلبات سحب.</div>')+'</div>';
   host.appendChild(sec);
 };
 window.adminPayoutModal=function(id,status){
   openModal(`<div class="modalHead"><h2>معالجة طلب السحب</h2><button class="x" onclick="closeModal()">×</button></div><div class="field"><label>ملاحظة الإدارة</label><textarea id="payoutAdminNote"></textarea></div><div class="actions">${status==='pending'?`<button class="btn soft" onclick="adminPayoutAction(${id},'processing')">قيد التحويل</button>`:''}<button class="btn green" onclick="adminPayoutAction(${id},'paid')">تم التحويل</button><button class="btn danger" onclick="adminPayoutAction(${id},'rejected')">رفض</button></div>`);
 };
 window.adminPayoutAction=async function(id,status){
   const note=document.getElementById('payoutAdminNote').value;
   const {r,j}=await api('/api/admin/payouts/'+id,{method:'PATCH',body:JSON.stringify({status,admin_note:note})});
   if(!r.ok)return toast(j?.error==='payout_finalized'?'الطلب مقفل مسبقًا':'تعذر تحديث طلب السحب');
   closeModal();toast(status==='paid'?'تم تسجيل السحب كمنفذ':status==='processing'?'تم تحويله لقيد التنفيذ':'تم رفض طلب السحب');renderAdmin();
 };
})();
</script>
<style>
.orderKpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:0 0 14px}.orderKpi{background:#fff;border:1px solid #e6ebf1;border-radius:15px;padding:11px}.orderKpi small{display:block;font-size:8px;color:#64748b;margin-bottom:5px}.orderKpi b{font-family:Alexandria;font-size:16px}.orderTabs{display:flex;gap:7px;overflow:auto;padding:2px 0 10px}.orderTabs .btn{white-space:nowrap}.orderTabs .btn.on{background:#172554;color:#fff;border-color:#172554}.orderHint{margin-top:7px;font-size:8px;color:#64748b;line-height:1.55}.orderHint.attn{color:#9a3412;font-weight:700}.settlementCard,.completionCard,.deliveryDecision{border:1px solid #dbe4ef;border-radius:16px;padding:12px;margin:10px 0;background:#fff}.deliveryDecision{background:linear-gradient(135deg,#f0fdf4,#f8fafc);border-color:#bbf7d0}.completionCard{background:linear-gradient(135deg,#f8fafc,#eef3ff);border-color:#dbeafe}.settlementGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:9px}.settlementCell{border-radius:12px;background:#f8fafc;padding:9px}.settlementCell small{display:block;color:#64748b;font-size:7px;margin-bottom:4px}.settlementCell b{font-family:Alexandria;font-size:11px}.reviewStars{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:6px}.reviewStars button{height:38px;border:1px solid #dbe4ef;border-radius:11px;background:#fff;font-size:18px;cursor:pointer}.reviewStars button.on{background:#fff7ed;border-color:#fdba74}.reviewSummary{display:flex;gap:7px;flex-wrap:wrap;margin:8px 0}.reviewSummary .pill{font-size:8px}.reviewComment{font-size:9px;color:#475569;line-height:1.7;margin:7px 0 0}.completeConfirm{padding:12px;border:1px solid #bbf7d0;background:#f0fdf4;border-radius:15px;margin:10px 0}.completeConfirm p{font-size:9px;color:#475569;line-height:1.7;margin:5px 0 0}@media(max-width:760px){.orderKpis{grid-template-columns:repeat(2,minmax(0,1fr))}.settlementGrid{grid-template-columns:1fr}.reviewStars button{height:42px}}
</style>
<script>
(function(){
 let orderListFilter='all';
 const orderNeedsAction=o=>me?.user?.role==='client'?((o.payment_status==='unpaid'&&o.status==='awaiting_payment')||o.status==='delivered'||(o.status==='completed'&&!o.reviewed)):['in_progress','revision_requested'].includes(o.status);
 const orderHint=o=>{if(me?.user?.role==='client'){if(o.payment_status==='unpaid'&&o.status==='awaiting_payment')return['أكمل الدفع ليبدأ المستقل','attn'];if(o.status==='delivered')return['راجع التسليم: اعتمد أو اطلب تعديل','attn'];if(o.status==='completed'&&!o.reviewed)return['اكتمل الطلب — باقي تقييم التجربة','attn'];if(o.status==='in_progress'||o.status==='revision_requested')return['المستقل يعمل على الطلب الآن',''];if(o.status==='completed')return['مكتمل ومقيّم',''];}else{if(o.status==='awaiting_payment')return['بانتظار دفع العميل قبل بدء العمل',''];if(o.status==='revision_requested')return['العميل طلب تعديل — راجع الملاحظات وأعد التسليم','attn'];if(o.status==='in_progress')return['الطلب جاهز للعمل والتسليم','attn'];if(o.status==='delivered')return['بانتظار مراجعة العميل للتسليم',''];if(o.status==='completed')return['اكتمل الطلب · صافي مستحق '+money(o.net_amount||0),''];}return['','']};
 window.setOrderFilter=function(v){orderListFilter=v;renderOrders()};
 window.renderOrders=async function(){const {j}=await api('/api/v1/orders');const all=j?.items||[];const active=all.filter(o=>!['completed','cancelled'].includes(o.status)),attention=all.filter(orderNeedsAction),completed=all.filter(o=>o.status==='completed');let a=all;if(orderListFilter==='action')a=attention;else if(orderListFilter==='active')a=active;else if(orderListFilter==='completed')a=completed;const total=me.user.role==='freelancer'?completed.reduce((s,o)=>s+Number(o.net_amount||0),0):all.reduce((s,o)=>s+Number(o.amount||0),0);$('orders').innerHTML=`<div class="sectionHead"><div><h2>${me.user.role==='freelancer'?'أعمالي':'طلباتي'}</h2><p>${me.user.role==='freelancer'?'تابع التنفيذ والتسليم ومستحقاتك':'كل طلب من الاختيار إلى الاعتماد والتقييم'}</p></div></div><div class="orderKpis"><div class="orderKpi"><small>يحتاج إجراء</small><b>${attention.length}</b></div><div class="orderKpi"><small>نشط الآن</small><b>${active.length}</b></div><div class="orderKpi"><small>مكتمل</small><b>${completed.length}</b></div><div class="orderKpi"><small>${me.user.role==='freelancer'?'صافي المكتمل':'قيمة الطلبات'}</small><b>${money(total)}</b></div></div><div class="orderTabs"><button class="btn ${orderListFilter==='all'?'on':'ghost'}" onclick="setOrderFilter('all')">الكل ${all.length}</button><button class="btn ${orderListFilter==='action'?'on':'ghost'}" onclick="setOrderFilter('action')">يحتاج إجراء ${attention.length}</button><button class="btn ${orderListFilter==='active'?'on':'ghost'}" onclick="setOrderFilter('active')">نشط ${active.length}</button><button class="btn ${orderListFilter==='completed'?'on':'ghost'}" onclick="setOrderFilter('completed')">مكتمل ${completed.length}</button></div><div class="list">${a.map(o=>{const h=orderHint(o);return `<div class="rowCard"><div><h3>${esc(o.title)}</h3><p>${me.user.role==='client'?'المستقل: '+esc(o.freelancer_name):'العميل: '+esc(o.client_name)}</p><div class="rowMeta"><span class="pill ${statusClass(o.status)}">${statusMap[o.status]||o.status}</span><span class="pill ${statusClass(o.payment_status)}">${statusMap[o.payment_status]||o.payment_status}</span>${o.status==='completed'&&o.reviewed?'<span class="pill green">★ تم التقييم</span>':''}</div><div class="orderHint ${h[1]}">${h[0]}</div></div><div><div class="money">${me.user.role==='freelancer'&&o.status==='completed'?money(o.net_amount||0):money(o.amount)}</div>${me.user.role==='freelancer'&&o.status==='completed'?'<div style="font-size:7px;color:#64748b;text-align:center">صافي</div>':''}<button class="btn ghost" style="margin-top:7px" onclick="orderModal(${o.id})">فتح الطلب</button></div></div>`}).join('')||'<div class="card empty">ما فيه طلبات ضمن هذا الفلتر.</div>'}</div>`};
 const baseOrder=window.orderModal;
 if(typeof baseOrder==='function')window.orderModal=async function(id){await baseOrder(id);const modal=$('modal');if(!modal||modal.querySelector('[data-completion-v417]'))return;let o=null;try{const x=await api('/api/v1/orders/'+id);o=x.j}catch(e){}if(!o)return;const anchor=modal.querySelector('[data-timeline]')||modal.querySelector('.actions');const sec=document.createElement('div');sec.dataset.completionV417='1';
  if(me.user.role==='client'&&o.status==='delivered'){sec.className='deliveryDecision';sec.innerHTML='<div class="row space"><div><b style="font-family:Alexandria;font-size:10px">التسليم جاهز لمراجعتك</b><div class="orderHint">راجع الملفات والملاحظات فوق. الاعتماد يقفل التنفيذ ويحوّل الطلب إلى مكتمل.</div></div><span class="pill green">جاهز للاعتماد</span></div>'}
  else if(o.status==='completed'&&me.user.role==='freelancer'){sec.className='settlementCard';sec.innerHTML='<div class="row space"><div><b style="font-family:Alexandria;font-size:10px">ملخص المستحق</b><div class="orderHint">بعد اكتمال الطلب يدخل صافي المبلغ ضمن رصيد أرباحك حسب حالة السحوبات.</div></div><span class="pill green">مكتمل</span></div><div class="settlementGrid"><div class="settlementCell"><small>قيمة الطلب</small><b>'+money(o.amount||0)+'</b></div><div class="settlementCell"><small>عمولة المنصة</small><b>- '+money(o.platform_fee||0)+'</b></div><div class="settlementCell"><small>صافي المستقل</small><b>'+money(o.net_amount||0)+'</b></div></div>'}
  else if(o.status==='completed'&&me.user.role==='client'){sec.className='completionCard';const reviewed=!!o.review_id;sec.innerHTML='<div class="row space"><div><b style="font-family:Alexandria;font-size:10px">الطلب مكتمل</b><div class="orderHint">'+(reviewed?'تم حفظ تقييمك ويمكنك تحديثه متى احتجت.':'قيّم التجربة عشان يظهر سجل أوضح للمستقلين في المنصة.')+'</div></div><span class="pill '+(reviewed?'green':'amber')+'">'+(reviewed?'★ تم التقييم':'بانتظار التقييم')+'</span></div>'+(reviewed?'<div class="reviewSummary"><span class="pill green">الجودة '+Number(o.review_quality||0)+'/5</span><span class="pill blue">الالتزام '+Number(o.review_timeliness||0)+'/5</span><span class="pill gray">التواصل '+Number(o.review_communication||0)+'/5</span></div>'+(o.review_comment?'<div class="reviewComment">“'+esc(o.review_comment)+'”</div>':'')+'<button class="btn ghost" style="margin-top:9px" onclick="reviewModal('+id+')">تحديث التقييم</button>':'<button class="btn primary" style="margin-top:9px" onclick="reviewModal('+id+')">★ قيّم المستقل</button>')}
  else return;(anchor||modal).insertAdjacentElement(anchor?'beforebegin':'beforeend',sec)
 };
 window.completeOrder=function(id){openModal('<div class="modalHead"><h2>اعتماد التسليم</h2><button class="x" onclick="orderModal('+id+')">×</button></div><div class="completeConfirm"><b style="font-family:Alexandria;font-size:10px">هل العمل منجز بالشكل المطلوب؟</b><p>بعد الاعتماد يتحول الطلب إلى مكتمل ويُضاف صافي المستحق لأرباح المستقل. إذا عندك تعديل متبقٍ، ارجع واطلبه قبل الاعتماد.</p></div><div class="actions"><button class="btn ghost" onclick="orderModal('+id+')">رجوع للمراجعة</button><button class="btn green" onclick="confirmCompleteOrder('+id+')">نعم، اعتماد وإكمال</button></div>')};
 window.confirmCompleteOrder=async function(id){const {r,j}=await api('/api/v1/orders/'+id+'/complete',{method:'POST',body:'{}'});if(!r.ok)return toast(j?.error==='invalid_order_state'?'الطلب غير جاهز للاعتماد':'تعذر اعتماد التسليم');toast('تم اعتماد التسليم وإكمال الطلب');reviewModal(id)};
 const ratingNames={quality:'الجودة',timeliness:'الالتزام',communication:'التواصل'};
 window.setReviewRating=function(k,v){const el=document.getElementById('r_'+k);if(el)el.value=v;document.querySelectorAll('[data-rate="'+k+'"]').forEach(b=>b.classList.toggle('on',Number(b.dataset.v)<=Number(v)))};
 window.reviewModal=async function(id){let o=null;try{const x=await api('/api/v1/orders/'+id);o=x.j}catch(e){}const vals={quality:Number(o?.review_quality||5),timeliness:Number(o?.review_timeliness||5),communication:Number(o?.review_communication||5)};const row=k=>'<div class="field full"><label>'+ratingNames[k]+'</label><input type="hidden" id="r_'+k+'" value="'+vals[k]+'"><div class="reviewStars">'+[1,2,3,4,5].map(v=>'<button type="button" class="'+(v<=vals[k]?'on':'')+'" data-rate="'+k+'" data-v="'+v+'" onclick="setReviewRating(\''+k+'\','+v+')">★</button>').join('')+'</div></div>';openModal('<div class="modalHead"><div><h2>قيّم التجربة</h2><div style="font-size:9px;color:#64748b">التقييم يساعد في تحسين جودة الاختيار بدون مبالغة أو وعود آلية.</div></div><button class="x" onclick="closeModal()">×</button></div><div class="form2">'+row('quality')+row('timeliness')+row('communication')+'<div class="field full"><label>تعليق — اختياري</label><textarea id="rcom" placeholder="وش أعجبك؟ وهل فيه شيء يحتاج يتحسن؟">'+esc(o?.review_comment||'')+'</textarea></div></div><div class="actions"><button class="btn primary" onclick="submitReview('+id+')">حفظ التقييم</button></div>')};
 window.submitReview=async function(id){const b={quality:+document.getElementById('r_quality').value,timeliness:+document.getElementById('r_timeliness').value,communication:+document.getElementById('r_communication').value,comment:document.getElementById('rcom').value};const {r}=await api('/api/v1/orders/'+id+'/review',{method:'POST',body:JSON.stringify(b)});if(!r.ok)return toast('راجع التقييم');closeModal();toast('تم حفظ تقييمك');renderOrders()};
})();
</script>
<style>
.cancelBanner{margin:10px 0;padding:12px;border:1px solid #fed7aa;background:#fff7ed;border-radius:15px}.cancelBanner.approved{background:#f8fafc;border-color:#dbe4ef}.cancelBanner.rejected{background:#f0fdf4;border-color:#bbf7d0}.cancelBanner b{font-family:Alexandria;font-size:10px}.cancelBanner p{font-size:8px;color:#64748b;line-height:1.65;margin:4px 0}.cancelAdminGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.cancelAdminCard{border:1px solid #e6ebf1;border-radius:15px;background:#fff;padding:11px}.cancelAdminCard h3{font-family:Alexandria;font-size:10px;margin:0}.cancelAdminCard p{font-size:8px;color:#64748b;line-height:1.6;margin:4px 0}.refundWarn{padding:8px 9px;border-radius:11px;background:#fff7ed;color:#9a3412;font-size:8px;margin-top:7px}@media(max-width:760px){.cancelAdminGrid{grid-template-columns:1fr}}
</style>
<script>
(function(){
 const cancelStatus=s=>({pending:'بانتظار المراجعة',in_review:'قيد المراجعة',approved:'تم اعتماد الإلغاء',rejected:'تم رفض الإلغاء'}[s]||s);
 const refundStatus=s=>({not_needed:'لا يوجد استرداد',pending:'الاسترداد قيد المراجعة',manual_required:'يلزم استرداد عبر مزود الدفع',refunded:'تم تسجيل الاسترداد'}[s]||s);
 const baseOrder=window.orderModal;
 if(typeof baseOrder==='function')window.orderModal=async function(id){await baseOrder(id);const modal=$('modal');if(!modal||modal.querySelector('[data-cancel-v418]'))return;let o=null,c=null;try{const [ro,rc]=await Promise.all([api('/api/v1/orders/'+id),api('/api/v1/orders/'+id+'/cancellation')]);o=ro.j;c=rc.j?.item||null}catch(e){}if(!o)return;const actions=modal.querySelector('.actions');
  if(c){const box=document.createElement('div');box.dataset.cancelV418='1';box.className='cancelBanner '+(c.status==='approved'?'approved':c.status==='rejected'?'rejected':'');box.innerHTML='<div class="row space"><b>طلب الإلغاء: '+cancelStatus(c.status)+'</b><span class="pill '+(c.status==='approved'?'gray':c.status==='rejected'?'green':'amber')+'">'+cancelStatus(c.status)+'</span></div><p>'+esc(c.reason)+(c.details?' · '+esc(c.details):'')+'</p><p>'+refundStatus(c.refund_status||'not_needed')+(c.admin_note?' · '+esc(c.admin_note):'')+'</p>';const a=modal.querySelector('[data-timeline]')||actions;(a||modal).insertAdjacentElement(a?'beforebegin':'beforeend',box)}
  if(!c&&!['completed','cancelled','disputed'].includes(o.status)&&actions){const b=document.createElement('button');b.className='btn danger';b.textContent='طلب إلغاء';b.onclick=()=>cancellationModal(id);actions.appendChild(b)}
 };
 window.cancellationModal=function(id){openModal('<div class="modalHead"><div><h2>طلب إلغاء الطلب</h2><div style="font-size:9px;color:#64748b">الإلغاء يحتاج مراجعة، وإذا كان الطلب مدفوعًا تُراجع حالة الاسترداد بشكل مستقل.</div></div><button class="x" onclick="orderModal('+id+')">×</button></div><div class="field"><label>سبب الإلغاء</label><select id="cancelReason"><option>تغيرت الحاجة للمهمة</option><option>تعذر الاتفاق على التفاصيل</option><option>تأخر التنفيذ</option><option>تعذر الاستمرار من أحد الأطراف</option><option>سبب آخر</option></select></div><div class="field"><label>تفاصيل إضافية</label><textarea id="cancelDetails" placeholder="وضح السبب عشان الإدارة تراجع الطلب بسرعة"></textarea></div><div class="actions"><button class="btn ghost" onclick="orderModal('+id+')">رجوع</button><button class="btn danger" onclick="submitCancellation('+id+')">إرسال طلب الإلغاء</button></div>')};
 window.submitCancellation=async function(id){const body={reason:document.getElementById('cancelReason').value,details:document.getElementById('cancelDetails').value};const {r,j}=await api('/api/v1/orders/'+id+'/cancellation',{method:'POST',body:JSON.stringify(body)});if(!r.ok){if(j?.error==='active_cancellation_exists')return toast('يوجد طلب إلغاء قيد المراجعة');if(j?.error==='invalid_order_state')return toast('لا يمكن إلغاء الطلب في حالته الحالية');return toast('تعذر إرسال طلب الإلغاء')}toast('تم إرسال طلب الإلغاء للمراجعة');orderModal(id)};
